# Private input file. Copy OUTSIDE the repository and Obsidian vault.
# Plain values after =, no quotes, spaces, export, or inline comments.
KIS_ENV=vts
KIS_APP_KEY=
KIS_APP_SECRET=
# First 8 digits of the VIRTUAL account, without hyphens.
KIS_CANO=
# Last 2 digits of the VIRTUAL account; do not assume a default.
KIS_PRODUCT_CODE=
# Optional 6-digit Korean stock code for read-only connectivity testing.
# This does not select a trading universe or strategy.
KIS_TEST_SYMBOL=
