# Copy to infra/sandbox/.env by running: ./scripts/sandbox.sh bootstrap
# This example is safe to commit. Never place real credentials here.

COMPOSE_PROJECT_NAME=tradingagent
HERMES_IMAGE_TAG=latest

# WSL path to the dedicated private Obsidian subfolder, not the whole Vault.
LLM_WIKI_PATH=/mnt/c/Users/your-windows-user/Documents/Obsidian/ossai_llmwiki/Projects/Hermes-Paper-Trading

# Generated locally by the bootstrap command.
NOVNC_PASSWORD=replace-with-8-random-characters
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=tradingagent
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=replace-with-a-random-password
HERMES_DASHBOARD_BASIC_AUTH_SECRET=replace-with-a-random-signing-secret

# Local-only ports.
NOVNC_PORT=6080
HERMES_DASHBOARD_PORT=9119
