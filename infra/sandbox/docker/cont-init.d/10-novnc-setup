#!/command/with-contenv sh
set -eu

if [ -z "${NOVNC_PASSWORD:-}" ]; then
    echo "[novnc] NOVNC_PASSWORD is required" >&2
    exit 1
fi

export HOME=/opt/data
umask 077

install -d -m 0700 -o hermes -g hermes /opt/data/.vnc
install -d -m 0700 -o hermes -g hermes /opt/data/.config
install -d -m 0700 -o hermes -g hermes /opt/data/.config/autostart
install -d -m 0700 -o hermes -g hermes /opt/data/Desktop
install -d -m 0700 -o hermes -g hermes /opt/data/run

password_tool="$(command -v tigervncpasswd || command -v vncpasswd)"
printf '%s\n' "${NOVNC_PASSWORD}" | "${password_tool}" -f > /opt/data/.vnc/passwd
chown hermes:hermes /opt/data/.vnc/passwd
chmod 0600 /opt/data/.vnc/passwd

cat > /opt/data/Desktop/Sandbox-Terminal.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=Sandbox Terminal
Comment=Open a terminal inside the isolated TradingAgent environment
Exec=xfce4-terminal --working-directory=/workspace/trading-agent
Icon=utilities-terminal
Terminal=false
EOF

cat > /opt/data/Desktop/Hermes-Status.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=Hermes Status
Comment=Inspect Hermes gateway, cron, and dashboard status
Exec=xfce4-terminal --hold --command="sh -lc 'hermes gateway status; echo; hermes cron status; echo; hermes --version'"
Icon=utilities-system-monitor
Terminal=false
EOF

chmod 0755 /opt/data/Desktop/*.desktop
chown -R hermes:hermes /opt/data/.vnc /opt/data/.config /opt/data/Desktop /opt/data/run
